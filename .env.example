# StreamCraft / openstream-* configuration
# Copy to .env if you use a dotenv loader locally (optional — most vars are process env).
# cp .env.example .env

# === FFmpeg sidecars (optional overrides) ===
# Resolution order: these env vars → bundled Helpers → PATH
OPENSTREAM_FFMPEG=
OPENSTREAM_FFPROBE=

# === Agent / CLI ===
# When set, routes some agent actions via the desktop app inbox
OPENSTREAM_VIA_APP=

# === Install script (macOS) ===
# Override GitHub repo for scripts/install.sh
STREAMCRAFT_GITHUB_REPO=ROSITO/StreamCraft

# === Rust / logging (optional) ===
# RUST_LOG=info
# CARGO_TERM_COLOR=always
